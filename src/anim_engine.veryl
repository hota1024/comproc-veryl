/// 8x8 LED マトリクス向けのアニメーション生成器。
///
/// i_pattern で 4 種類を切り替える。
///
/// - 0: 中心から広がってまた縮む四角い輪
/// - 1: 跳ね返るボール
/// - 2: 列ごとに降ってくる雨
/// - 3: 回転するバー
///
/// 4 種類ぶんの盤面をそれぞれ組み合わせ回路で作っておき、最後に選ぶ。
/// 関数の入れ子は yosys が定数式として扱ってしまうことがあるので、
/// ループの中では関数を呼ばずにテーブルを引く形にしてある。
module AnimEngine (
    i_clk: input clock         ,
    i_rst: input reset_sync_low,
    /// 1 コマ進めるパルス。
    i_tick   : input  logic       ,
    i_pattern: input  logic<2>    ,
    o_grid   : output logic<8> [8],
) {
    var phase   : logic<3>;
    var ring_sel: logic<2>;
    var ring_up : logic   ;
    var ball_x  : logic<3>;
    var ball_y  : logic<3>;
    var ball_dx : logic   ;
    var ball_dy : logic   ;

    // ---- 中心からの距離 |2v - 7|。輪の番号を出すのに使う ----
    var spread: logic<4> [8];
    always_comb {
        spread[0] = 7;
        spread[1] = 5;
        spread[2] = 3;
        spread[3] = 1;
        spread[4] = 1;
        spread[5] = 3;
        spread[6] = 5;
        spread[7] = 7;
    }

    // ---- 雨。列ごとに落ちる位相をずらす ----
    var rain_head: logic<3> [8];
    always_comb {
        rain_head[0] = phase + 3'd6;
        rain_head[1] = phase + 3'd0;
        rain_head[2] = phase + 3'd3;
        rain_head[3] = phase + 3'd4;
        rain_head[4] = phase + 3'd1;
        rain_head[5] = phase + 3'd7;
        rain_head[6] = phase + 3'd2;
        rain_head[7] = phase + 3'd5;
    }

    var g_ring: logic<8> [8];
    var g_ball: logic<8> [8];
    var g_rain: logic<8> [8];
    var g_bar : logic<8> [8];

    always_comb {
        for y in 0..8 {
            for x in 0..8 {
                var far : logic<4>;
                var ring: logic<2>;
                var head: logic<3>;

                // 四角い輪: 縦横のうち遠いほうで輪の番号が決まる。
                far  = if spread[y] >= spread[x] ? spread[y] : spread[x];
                ring = ((far - 4'd1) >> 1) as 2;

                g_ring[y][x] = ring == ring_sel;
                g_ball[y][x] = (x as 3 == ball_x) && (y as 3 == ball_y);

                // 雨: 先頭と 1 つ上の 2 マスを光らせて尾を引かせる。
                head         = rain_head[x];
                g_rain[y][x] = (y as 3 == head) || (y as 3 == head - 3'd1);

                // 回転するバー: 横・斜め・縦・逆斜めを順に出す。
                g_bar[y][x] = case phase[1:0] {
                    0      : (y == 3) || (y == 4),
                    1      : x == y,
                    2      : (x == 3) || (x == 4),
                    default: x == 7 - y,
                };
            }
        }
    }

    always_comb {
        for y in 0..8 {
            o_grid[y] = case i_pattern {
                0      : g_ring[y],
                1      : g_ball[y],
                2      : g_rain[y],
                default: g_bar[y],
            };
        }
    }

    always_ff (i_clk, i_rst) {
        if_reset {
            phase    = 0;
            ring_sel = 0;
            ring_up  = 1;
            ball_x   = 1;
            ball_y   = 2;
            ball_dx  = 1;
            ball_dy  = 1;
        } else if i_tick {
            phase = phase + 1;

            // 四角い輪を外へ広げ、外周まで行ったら内へ戻す。
            if ring_up {
                if ring_sel == 3 {
                    ring_sel = 2;
                    ring_up  = 0;
                } else {
                    ring_sel = ring_sel + 1;
                }
            } else {
                if ring_sel == 0 {
                    ring_sel = 1;
                    ring_up  = 1;
                } else {
                    ring_sel = ring_sel - 1;
                }
            }

            // ボールを進めて、壁に当たったら向きを変える。
            if ball_dx {
                if ball_x == 7 {
                    ball_dx = 0;
                    ball_x  = 6;
                } else {
                    ball_x = ball_x + 1;
                }
            } else {
                if ball_x == 0 {
                    ball_dx = 1;
                    ball_x  = 1;
                } else {
                    ball_x = ball_x - 1;
                }
            }
            if ball_dy {
                if ball_y == 7 {
                    ball_dy = 0;
                    ball_y  = 6;
                } else {
                    ball_y = ball_y + 1;
                }
            } else {
                if ball_y == 0 {
                    ball_dy = 1;
                    ball_y  = 1;
                } else {
                    ball_y = ball_y - 1;
                }
            }
        }
    }
}
