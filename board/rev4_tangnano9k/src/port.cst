// ComProc CPU ボード Rev4 (Tang Nano 9K) のピン割り当て。
// comproc/src/cpu/board/rev4_tangnano9k/src/port.cst と
// workshop/board-checker の port.cst を元にしている。
//
// I/O バンクごとに IO_TYPE を揃えること。左バンク（pin 3, 4, 10-16）は
// IO_TYPE を書かずにバンク既定に任せる。書くと apicula が電圧衝突で弾く。

// ---- クロックとボタン ----
IO_LOC "sys_clk" 52;
IO_PORT "sys_clk" PULL_MODE=NONE IO_TYPE=LVCMOS33;
// Tang Nano 9K のオンボードボタン S2（押すと Low）。リセット。
IO_LOC "rst_n_raw" 4;
IO_PORT "rst_n_raw" PULL_MODE=UP;
// Tang Nano 9K のオンボードボタン S1（押すと Low）。ユーザーボタン。
IO_LOC "btn_n_raw" 3;
IO_PORT "btn_n_raw" PULL_MODE=UP;

// ---- 8x8 LED マトリクス + 7 セグ ----
// 行は P-ch MOSFET のハイサイドスイッチ。アクティブ Low。
IO_LOC "led_row[0]" 37; // ROW1
IO_LOC "led_row[1]" 36; // ROW2
IO_LOC "led_row[2]" 39; // ROW3
IO_LOC "led_row[3]" 25; // ROW4
IO_LOC "led_row[4]" 26; // ROW5
IO_LOC "led_row[5]" 27; // ROW6
IO_LOC "led_row[6]" 28; // ROW7
IO_LOC "led_row[7]" 29; // ROW8
IO_LOC "led_row[8]" 38; // 7SEG の共通アノード
IO_PORT "led_row[0]" IO_TYPE=LVCMOS33;
IO_PORT "led_row[1]" IO_TYPE=LVCMOS33;
IO_PORT "led_row[2]" IO_TYPE=LVCMOS33;
IO_PORT "led_row[3]" IO_TYPE=LVCMOS33;
IO_PORT "led_row[4]" IO_TYPE=LVCMOS33;
IO_PORT "led_row[5]" IO_TYPE=LVCMOS33;
IO_PORT "led_row[6]" IO_TYPE=LVCMOS33;
IO_PORT "led_row[7]" IO_TYPE=LVCMOS33;
IO_PORT "led_row[8]" IO_TYPE=LVCMOS33;
// 列データ D0..D7。TBD62083 のシンクドライバ経由でアクティブ High。
// マトリクスの COL1..COL8 と 7 セグのセグメントが同じバスを共有する。
IO_LOC "led_col[0]" 30;
IO_LOC "led_col[1]" 33;
IO_LOC "led_col[2]" 34;
IO_LOC "led_col[3]" 40;
IO_LOC "led_col[4]" 35;
IO_LOC "led_col[5]" 41;
IO_LOC "led_col[6]" 42;
IO_LOC "led_col[7]" 51;
IO_PORT "led_col[0]" IO_TYPE=LVCMOS33;
IO_PORT "led_col[1]" IO_TYPE=LVCMOS33;
IO_PORT "led_col[2]" IO_TYPE=LVCMOS33;
IO_PORT "led_col[3]" IO_TYPE=LVCMOS33;
IO_PORT "led_col[4]" IO_TYPE=LVCMOS33;
IO_PORT "led_col[5]" IO_TYPE=LVCMOS33;
IO_PORT "led_col[6]" IO_TYPE=LVCMOS33;
IO_PORT "led_col[7]" IO_TYPE=LVCMOS33;

// ---- キャラクタ LCD (HD44780 互換, 4 ビットモード) ----
IO_LOC "lcd_e"     76;
IO_LOC "lcd_rw"    77;
IO_LOC "lcd_rs"    63;
// 本家 port.cst の lcd_db[7:4] に対応する。
// Veryl は [3:0] のビット範囲しか生成しないので添字を振り直してある。
IO_LOC "lcd_db[3]" 32; // DB7
IO_LOC "lcd_db[2]" 31; // DB6
IO_LOC "lcd_db[1]" 49; // DB5
IO_LOC "lcd_db[0]" 48; // DB4
IO_PORT "lcd_e"     IO_TYPE=LVCMOS33;
IO_PORT "lcd_rw"    IO_TYPE=LVCMOS33;
IO_PORT "lcd_rs"    IO_TYPE=LVCMOS33;
IO_PORT "lcd_db[3]" IO_TYPE=LVCMOS33;
IO_PORT "lcd_db[2]" IO_TYPE=LVCMOS33;
IO_PORT "lcd_db[1]" IO_TYPE=LVCMOS33;
IO_PORT "lcd_db[0]" IO_TYPE=LVCMOS33;

// ---- SW1（8 連 DIP スイッチ）----
// スイッチは GND に落とすだけなので内部プルアップが必須。押下で Low。
// Tang Nano 9K の RGB 液晶用ピンを ComProc ボードが流用している。
IO_LOC "sw_n_raw[0]" 79;
IO_LOC "sw_n_raw[1]" 80;
IO_LOC "sw_n_raw[2]" 81;
IO_LOC "sw_n_raw[3]" 82;
IO_LOC "sw_n_raw[4]" 83;
IO_LOC "sw_n_raw[5]" 84;
IO_LOC "sw_n_raw[6]" 85;
IO_LOC "sw_n_raw[7]" 86;
IO_PORT "sw_n_raw[0]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_PORT "sw_n_raw[1]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_PORT "sw_n_raw[2]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_PORT "sw_n_raw[3]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_PORT "sw_n_raw[4]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_PORT "sw_n_raw[5]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_PORT "sw_n_raw[6]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_PORT "sw_n_raw[7]" PULL_MODE=UP IO_TYPE=LVCMOS33;

// ---- UART ----
// ComProc CPU ボードの USB シリアル (U2 = AE-FT234X)。
// こちらを使うにはボード側の micro USB をつなぐ必要がある。
IO_LOC "uart_rx" 54;
IO_LOC "uart_tx" 53;
IO_PORT "uart_rx" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
// Tang Nano 9K 本体の USB シリアル (BL702)。書き込みに使う USB-C と同じ口。
// 左バンクなので IO_TYPE は指定しない。
IO_LOC "uart_rx2" 18;
IO_LOC "uart_tx2" 17;
IO_PORT "uart_rx2" PULL_MODE=UP;
IO_PORT "uart_tx2" PULL_MODE=UP;

// ---- ADC（コンパレータ + PWM DAC + サンプル&ホールド）----
IO_LOC "adc_cmp"     55;
IO_LOC "adc_sh_ctl"  56;
IO_LOC "adc_dac_pwm" 57;
IO_PORT "adc_cmp"     IO_TYPE=LVCMOS33;
IO_PORT "adc_sh_ctl"  IO_TYPE=LVCMOS33;
IO_PORT "adc_dac_pwm" IO_TYPE=LVCMOS33;

// ---- GPIO 8 本（Tang Nano 9K の HDMI ピンの流用）----
IO_LOC "gpio[0]" 68;
IO_LOC "gpio[1]" 69;
IO_LOC "gpio[2]" 70;
IO_LOC "gpio[3]" 71;
IO_LOC "gpio[4]" 72;
IO_LOC "gpio[5]" 73;
IO_LOC "gpio[6]" 74;
IO_LOC "gpio[7]" 75;
IO_PORT "gpio[0]" IO_TYPE=LVCMOS33;
IO_PORT "gpio[1]" IO_TYPE=LVCMOS33;
IO_PORT "gpio[2]" IO_TYPE=LVCMOS33;
IO_PORT "gpio[3]" IO_TYPE=LVCMOS33;
IO_PORT "gpio[4]" IO_TYPE=LVCMOS33;
IO_PORT "gpio[5]" IO_TYPE=LVCMOS33;
IO_PORT "gpio[6]" IO_TYPE=LVCMOS33;
IO_PORT "gpio[7]" IO_TYPE=LVCMOS33;

// ---- Tang Nano 9K オンボード LED（負論理）----
IO_LOC "onboard_led[0]" 10;
IO_LOC "onboard_led[1]" 11;
IO_LOC "onboard_led[2]" 13;
IO_LOC "onboard_led[3]" 14;
IO_LOC "onboard_led[4]" 15;
IO_LOC "onboard_led[5]" 16;
IO_PORT "onboard_led[0]" PULL_MODE=UP DRIVE=8;
IO_PORT "onboard_led[1]" PULL_MODE=UP DRIVE=8;
IO_PORT "onboard_led[2]" PULL_MODE=UP DRIVE=8;
IO_PORT "onboard_led[3]" PULL_MODE=UP DRIVE=8;
IO_PORT "onboard_led[4]" PULL_MODE=UP DRIVE=8;
IO_PORT "onboard_led[5]" PULL_MODE=UP DRIVE=8;
